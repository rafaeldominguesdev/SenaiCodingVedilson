package prjCineMatch.Classes;

public class Genero {
	//Atriutos
	
	private String generoFilme;
	private String descricaoFilme;
	


	//Construtores

	public void generoNovo(String generoFilme, String descricaoFilme) {
		this.generoFilme = generoFilme;
		this.descricaoFilme = descricaoFilme;
	}

	//Getters & Setters
	public String getGeneroFilme() {
		return generoFilme;
	}

	public void setGeneroFilme(String descricaoFilme2) {
		this.generoFilme = descricaoFilme2;
	}

	public String getDescricaoFilme() {
		return descricaoFilme;
	}

	public void setDescricaoFilme(String descricaoFilme) {
		this.descricaoFilme = descricaoFilme;
	}
	
	
	
	//toString
	@Override
	public String toString() {
		return  "autor " + this.descricaoFilme
				+"anoPublicacao " + this.descricaoFilme 
				+"}";
		
	
	}}
